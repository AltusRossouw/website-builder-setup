{
  "name": "opencode-website-builder-setup",
  "version": "1.0.0",
  "description": "Install the full AI website builder stack for OpenCode — UI/UX Pro Max, Framer Motion animations, and 21st.dev components. One plugin, three tools, zero coding experience needed.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "website-builder-setup"
  ],
  "scripts": {
    "build": "bun build index.ts --outdir dist --target node && tsc --declaration --emitDeclarationOnly --outDir dist",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "opencode",
    "website-builder",
    "ui-ux",
    "framer-motion",
    "21st-dev",
    "components",
    "web-design",
    "plugin"
  ],
  "author": "AltusRossouw",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AltusRossouw/website-builder-setup.git"
  },
  "bugs": {
    "url": "https://github.com/AltusRossouw/website-builder-setup/issues"
  },
  "homepage": "https://github.com/AltusRossouw/website-builder-setup#readme",
  "peerDependencies": {
    "@opencode-ai/plugin": ">=0.15.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^0.15.0",
    "@types/bun": "^1.3.1",
    "typescript": "^5.9.3"
  }
}
